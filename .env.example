# PostgreSQL доступен только внутри Docker-сети.
POSTGRES_DB=pi_planner
POSTGRES_USER=postgres
# Обязательное значение. Для генерации: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Единственный опубликованный порт приложения — Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Домен для Caddy и автоматического HTTPS.
CADDY_DOMAIN=localhost
# Отдельный HTTPS-домен Grafana. В production нужна DNS-запись на этот сервер.
GRAFANA_DOMAIN=grafana.localhost

# Наблюдаемость приложения: JSON удобен для Loki/Vector, бизнес-снимок из БД
# кэшируется, чтобы Prometheus не пересчитывал тяжёлые витрины каждый scrape.
PI_PLANNER_LOG_FORMAT=json
PI_PLANNER_METRICS_TTL=15

# Grafana доступна только через Caddy; Prometheus не публикуется на host.
GRAFANA_ADMIN_USER=admin
# Обязательно сменить перед доступом не только с localhost.
GRAFANA_ADMIN_PASSWORD=change-me-before-exposing
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Резервные копии PostgreSQL. Каталог создаётся рядом с docker-compose.yaml и
# не попадает в git. Для production укажите смонтированное/удалённое хранилище.
BACKUP_DIR=./backups
# UID/GID владельца BACKUP_DIR на Linux (`id -u` / `id -g`).
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY_RESTORE=true
# Ограничения контейнеров. Подстройте под размер хоста и нагрузку.
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g
DB_PIDS_LIMIT=200

APP_CPU_LIMIT=1.5
APP_MEMORY_LIMIT=512m
APP_PIDS_LIMIT=100

CADDY_CPU_LIMIT=1
CADDY_MEMORY_LIMIT=128m
CADDY_PIDS_LIMIT=100

BACKUP_CPU_LIMIT=0.5
BACKUP_MEMORY_LIMIT=256m
BACKUP_PIDS_LIMIT=100

PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_PIDS_LIMIT=100

GRAFANA_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_PIDS_LIMIT=200
