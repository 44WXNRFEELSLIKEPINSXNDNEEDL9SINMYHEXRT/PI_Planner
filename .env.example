# PostgreSQL доступен только внутри Docker-сети.
POSTGRES_DB=pi_planner
POSTGRES_USER=postgres
# Обязательное значение. Для генерации: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Доступ к сервису (ADR-027). Токен аварийного администратора — обязательное
# значение, не короче 16 символов; пока здесь стоит заглушка, приложение не
# запустится. Для генерации: openssl rand -hex 32
# Остальные пользователи: docker compose exec app python tools/manage_users.py create ИМЯ --role planner
PI_PLANNER_ADMIN_TOKEN=CHANGE-ME
# required (по умолчанию) | off — только для доверенной машины, без проверки токена.
PI_PLANNER_AUTH=required

# Единственный опубликованный порт приложения — Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Домен для Caddy и автоматического HTTPS.
CADDY_DOMAIN=localhost
# Отдельный HTTPS-домен Grafana. В production нужна DNS-запись на этот сервер.
GRAFANA_DOMAIN=grafana.localhost

# Наблюдаемость приложения: JSON удобен для Loki/Vector, бизнес-снимок из БД
# кэшируется, чтобы Prometheus не пересчитывал тяжёлые витрины каждый scrape.
PI_PLANNER_LOG_FORMAT=json
PI_PLANNER_METRICS_TTL=15

# Grafana доступна только через Caddy; Prometheus не публикуется на host.
GRAFANA_ADMIN_USER=admin
# Обязательно сменить перед доступом не только с localhost.
GRAFANA_ADMIN_PASSWORD=change-me-before-exposing
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Резервные копии PostgreSQL. Каталог создаётся рядом с docker-compose.yaml и
# не попадает в git. Для production укажите смонтированное/удалённое хранилище.
BACKUP_DIR=./backups
# UID/GID владельца BACKUP_DIR на Linux (`id -u` / `id -g`).
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY_RESTORE=true
# Ограничения контейнеров. Подстройте под размер хоста и нагрузку.
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g
DB_PIDS_LIMIT=200

APP_CPU_LIMIT=1.5
APP_MEMORY_LIMIT=512m
APP_PIDS_LIMIT=100

# Алгоритм одноразового bootstrap-plan (и ручного docker compose run bootstrap-plan).
# По умолчанию используется текущий стабильный планировщик. Для эксперимента:
# PLANNER_ALGORITHM=lns-cpsat@1
PLANNER_ALGORITHM=greedy-priority-topo@2
PLANNER_SEARCH_TIME_SECONDS=10
PLANNER_RANDOM_SEED=0
# Потоки CP-SAT для начального решения LNS. 1 — воспроизводимый результат;
# больше — лучше качество, но прогоны с одним seed могут различаться.
PLANNER_SEARCH_WORKERS=1

# Помощник: значения ключей остаются в окружении, профили хранят только env:NAME.
GEMINI_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
PI_PLANNER_INTERNAL_LLM_HOSTS=ollama
PI_PLANNER_KB_EMBED_BASE_URL=http://ollama:11434
PI_PLANNER_KB_EMBED_MODEL=embeddinggemma
PI_PLANNER_ASSISTANT_MESSAGE_DEADLINE_SECONDS=150
ASSISTANT_CPU_LIMIT=1.0
ASSISTANT_MEMORY_LIMIT=1g
# Для qwen3.5:9b требуется существенно больше памяти, чем для embeddinggemma.
OLLAMA_MEMORY_LIMIT=12g

CADDY_CPU_LIMIT=1
CADDY_MEMORY_LIMIT=128m
CADDY_PIDS_LIMIT=100

BACKUP_CPU_LIMIT=0.5
BACKUP_MEMORY_LIMIT=256m
BACKUP_PIDS_LIMIT=100

PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_PIDS_LIMIT=100

GRAFANA_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_PIDS_LIMIT=200

# Worker uses a separate database role. Generate: openssl rand -hex 32
ASSISTANT_DB_PASSWORD=replace-with-at-least-32-random-characters
